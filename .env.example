# Neon PostgreSQL connection string used by Prisma
DATABASE_URL=
DIRECT_URL=

# Secret used to sign API access tokens (replace with a long random value)
JWT_ACCESS_SECRET=

# Comma-separated browser origins allowed to call the API; leave empty for native-only
CORS_ORIGINS=

# URL of the API reachable from the mobile device/simulator
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Configure these before enabling corresponding features:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# REDIS_URL=
# EXPO_ACCESS_TOKEN=
